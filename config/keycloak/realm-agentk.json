{
  "realm": "agentk",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "__GOOGLE_CLIENT_ID__",
        "clientSecret": "__GOOGLE_CLIENT_SECRET__",
        "defaultScope": "openid email profile",
        "hostedDomain": "",
        "useJwksUrl": "true",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-email-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "google-username-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "name",
        "user.attribute": "fullName"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "k8s-admin",
        "description": "Permite autorizar operações classificadas como RISKY pelo Gateway"
      }
    ]
  },
  "requiredActions": [
    {"alias": "CONFIGURE_TOTP",         "providerId": "CONFIGURE_TOTP",         "enabled": true,  "defaultAction": false, "priority": 10, "config": {}},
    {"alias": "UPDATE_PASSWORD",         "providerId": "UPDATE_PASSWORD",         "enabled": true,  "defaultAction": false, "priority": 30, "config": {}},
    {"alias": "UPDATE_PROFILE",          "providerId": "UPDATE_PROFILE",          "enabled": true,  "defaultAction": false, "priority": 40, "config": {}},
    {"alias": "VERIFY_EMAIL",            "providerId": "VERIFY_EMAIL",            "enabled": true,  "defaultAction": false, "priority": 50, "config": {}},
    {"alias": "delete_account",          "providerId": "delete_account",          "enabled": false, "defaultAction": false, "priority": 60, "config": {}},
    {"alias": "TERMS_AND_CONDITIONS",    "providerId": "TERMS_AND_CONDITIONS",    "enabled": false, "defaultAction": false, "priority": 20, "config": {}}
  ],
