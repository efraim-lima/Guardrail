{
  "realm": "agentk",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "__GOOGLE_CLIENT_ID__",
        "clientSecret": "__GOOGLE_CLIENT_SECRET__",
        "defaultScope": "openid email profile",
        "hostedDomain": "",
        "useJwksUrl": "true",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-email-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "google-name-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-full-name-idp-mapper",
      "config": {
        "syncMode": "INHERIT"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "k8s-admin",
        "description": "Permite autorizar operações classificadas como RISKY pelo Gateway"
      }
    ]
  },
  "users": [
    {
      "username": "k8s-admin",
      "email": "k8sadmin@agentk.internal",
      "enabled": true,
      "emailVerified": true,
      "firstName": "K8s",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "__K8S_ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": ["k8s-admin"]
    },
    {
